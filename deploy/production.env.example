# Copy to .env.production (never commit it) and fill in every value.
# Generate each secret with:  openssl rand -hex 32

# Public hostnames; both must resolve (DNS A/AAAA records) to this server, with ports 80 and 443 open.
ADMIN_HOST=admin.example.com
API_HOST=api.example.com

# PostgreSQL (internal only; the same user owns both databases).
DB_USER=chatbot
DB_PASSWORD=

# Shared secret between backend and AI service (at least 32 characters).
AI_API_KEY=
# Claude API key (https://console.anthropic.com) for answering customer questions from the FAQs. If empty, the
# AI service falls back to keyword matching (answers with the FAQ whose question is most similar).
ANTHROPIC_API_KEY=
# Model and effort; see the README ("Answers from Claude") for cost.
AI_LLM_MODEL=claude-opus-5
AI_LLM_EFFORT=low
# JWT signing key for admin logins (at least 32 characters). Changing it signs everyone out.
JWT_SECRET=

# First super admin, created only on the first start (when no admin users exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Database backups (the "backup" service): how often, and how many days to keep them in ./backups.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Off-site copies of the backups (optional; enable with --profile offsite). Any S3-compatible storage:
# AWS S3, Backblaze B2, Cloudflare R2, Wasabi, Hetzner, MinIO, ... The bucket must already exist.
# OFFSITE_S3_PROVIDER: AWS, Cloudflare, Wasabi, Minio, ... or Other (see rclone's S3 providers).
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=              # e.g. https://s3.eu-central-003.backblazeb2.com (empty for AWS)
OFFSITE_S3_REGION=                # e.g. eu-central-1
OFFSITE_S3_BUCKET=
OFFSITE_S3_PREFIX=ai-chatbot-backups
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Backups are encrypted before upload with this password (at least 16 characters). Store it somewhere other
# than this server: without it the off-site copies cannot be decrypted.
OFFSITE_ENCRYPTION_PASSWORD=
OFFSITE_INTERVAL_MINUTES=60
# Days to keep off-site (0 = never delete, e.g. with bucket object lock or lifecycle rules).
OFFSITE_KEEP_DAYS=30
