# Copy to .env.production (never commit it) and fill in every value.
# Generate each secret with:  openssl rand -hex 32

# Public hostnames; both must resolve (DNS A/AAAA records) to this server, with ports 80 and 443 open.
ADMIN_HOST=admin.example.com
API_HOST=api.example.com

# PostgreSQL (internal only; the same user owns both databases).
DB_USER=chatbot
DB_PASSWORD=

# Shared secret between backend and AI service (at least 32 characters).
AI_API_KEY=
# JWT signing key for admin logins (at least 32 characters). Changing it signs everyone out.
JWT_SECRET=

# First super admin, created only on the first start (when no admin users exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
