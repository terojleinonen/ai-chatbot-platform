# Automatic HTTPS: Caddy obtains and renews Let's Encrypt certificates for both hosts (ports 80 and 443
# must be reachable from the internet) and redirects HTTP to HTTPS. *.localhost hosts get certificates from
# Caddy's internal CA instead, which is what the smoke test uses.
{
	# Optional: an email address for certificate expiry notices.
	# email ops@example.com
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Admin panel (single-page app).
{$ADMIN_HOST} {
	import security_headers
	header X-Frame-Options "DENY"
	# Strict CSP: only this site's own scripts and styles, and API calls only to API_HOST. It limits what an
	# injected script could do with the login token the admin panel keeps in localStorage.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://{$API_HOST} wss://{$API_HOST}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	encode zstd gzip
	root * /srv/admin
	try_files {path} /index.html
	file_server
}

# Backend API and chat WebSockets, plus the embeddable widget under /widget/.
{$API_HOST} {
	import security_headers
	encode zstd gzip

	# Health checks for load balancers and uptime monitors come from the backend's private management port;
	# every other actuator endpoint (e.g. metrics) stays internal.
	handle /actuator/health {
		reverse_proxy {
			dynamic a {
				name backend
				port 9090
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 10s
		}
	}
	handle /actuator/* {
		respond 404
	}

	handle_path /widget/* {
		root * /srv/widget
		file_server
	}

	handle {
		# API responses are JSON, never pages to render or frame.
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# Sets X-Forwarded-For/-Proto; the backend trusts them (SERVER_FORWARD_HEADERS_STRATEGY=native)
		# so rate limits see the real client IP. WebSocket upgrades are proxied automatically.
		#
		# Every backend instance (--scale backend=N) is found via DNS. Each client IP sticks to one instance:
		# SockJS fallback transports (used when a browser cannot open a WebSocket) send several requests per
		# chat session that must reach the same instance, and cookie stickiness is unreliable for a widget
		# embedded on other sites. A failed instance is skipped and its clients move to another one.
		reverse_proxy {
			dynamic a {
				name backend
				port 8080
				refresh 10s
			}
			lb_policy ip_hash
			lb_try_duration 5s
			fail_duration 10s
		}
	}
}
