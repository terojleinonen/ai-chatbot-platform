<?xml version="1.0" encoding="UTF-8"?>
<!-- Console logging as plain text (default) or JSON (LOG_FORMAT=json) for log collectors. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty name="LOG_FORMAT" source="logging.format" defaultValue="plain"/>

    <appender name="plain" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"ai-microservice"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="${LOG_FORMAT}"/>
    </root>
</configuration>
